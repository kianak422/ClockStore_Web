@* Views/Dashboard/Index.cshtml - Mã này thay thế toàn bộ nội dung file *@

@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<div class="container-fluid">
    <h2><i class="fas fa-chart-line"></i> Bảng Điều Khiển Quản Trị</h2>
    <hr />

    @await Html.PartialAsync("_PartialViews/_CardsPartial") 

    <div class="row mt-4">
        <div class="col-lg-8 col-md-12 mb-4">
            @await Html.PartialAsync("_PartialViews/_ChartPartial")
        </div>
        
        <div class="col-lg-4 col-md-12 mb-4">
            @* Ví dụ: @await Html.PartialAsync("_PartialViews/_QuickStatsPartial") *@
            <p>Thông tin thống kê nhanh sẽ ở đây (nếu có)</p>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            @await Html.PartialAsync("_PartialViews/_RecentTransactionsTable") 
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/chart.min.js"></script> 
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Đảm bảo ID này khớp với ID trong _ChartPartial.cshtml
            const ctx = document.getElementById('revenueChart'); 

            if (ctx) { // Kiểm tra xem phần tử canvas có tồn tại không
                 new Chart(ctx, {
                    type: 'bar', 
                    data: {
                        labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6'],
                        datasets: [{
                            label: 'Doanh Thu (Triệu VNĐ) - Mockup',
                            data: [150, 220, 300, 180, 450, 350],
                            backgroundColor: 'rgba(78, 115, 223, 0.5)', 
                            borderColor: 'rgba(78, 115, 223, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false, 
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }
        });
    </script>
}